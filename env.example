# NDI source name exactly as NDI shows it, no quotes.
# Leave blank and pick it in the web GUI instead.
NDI_SRC=
# Optional ip:port of the sender. Connects directly and skips NDI discovery.
NDI_URL=
FLOW_A=5fbec3b1-1b0f-417d-9059-8b94a47197ed
FLOW_B=6fbec3b1-1b0f-417d-9059-8b94a47197ee
MXL_DOMAIN=/dev/shm/mxl
# Read the source format from the NDI source when applying. Set to false to
# use SRC_W, SRC_H and SRC_FPS below instead.
SRC_AUTO=true
SRC_W=1920
SRC_H=1080
OUT_W=1080
OUT_H=1920
SRC_FPS=50
SCALER=lanczos
GST_DEBUG=2
# Frame rate of the live preview in the GUI. Costs a few percent of one core at 12.
PREVIEW_FPS=12
GUI_PORT=8080
# Initial NDI discovery method for a fresh install: mdns or server.
# After setup, change it in the GUI or with scripts/ndi-mode.sh.
NDI_DISCOVERY=mdns
UBUNTU_VERSION=24.04
